{
  "name": "md-fire-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run tests/collab.test.ts tests/editor.test.tsx",
    "test:rules": "firebase emulators:exec --only firestore --project demo-mdfire \"vitest run tests/firestore.rules.test.ts\"",
    "test:collab": "firebase emulators:exec --only firestore --project demo-mdfire \"vitest run tests/collab.integration.test.ts\"",
    "test:all": "npm run test:unit && npm run test:rules && npm run test:collab && npm run test:agent",
    "test:unit": "vitest run tests/collab.test.ts tests/editor.test.tsx",
    "test:agent": "firebase emulators:exec --only firestore,auth --project demo-mdfire \"vitest run tests/agent.test.ts\"",
    "mdfire": "node agent/cli.mjs",
    "mdfire-mcp": "node agent/mcp.mjs"
  },
  "dependencies": {
    "@tiptap/extension-collaboration": "^3.35.0",
    "@tiptap/extension-collaboration-caret": "^3.35.0",
    "@tiptap/extension-placeholder": "^3.35.0",
    "@tiptap/pm": "^3.35.0",
    "@tiptap/react": "^3.35.0",
    "@tiptap/starter-kit": "^3.35.0",
    "firebase": "^13.4.0",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tiptap-markdown": "^0.9.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "autoprefixer": "^10.7.0",
    "jsdom": "^31.0.1",
    "oxlint": "^1.90.0",
    "postcss": "^8.5.33",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.1.1"
  },
  "bin": {
    "mdfire": "agent/cli.mjs"
  }
}
