rules_version = '2';

// FireMD Editor — security rules
//
// Model
//   folders/{folderId}
//     ownerId, name, memberIds[], roles{uid: owner|editor|viewer},
//     access: restricted | link-view | link-edit, createdAt, updatedAt
//   notes/{noteId}
//     ownerId, folderId|null, aclSource: own | folder,
//     memberIds[], roles{}, access, title, markdown, version, createdAt, updatedAt
//   notes/{noteId}/updates/{id}      Yjs blocks: { v, jid, hash, bytes, data, clientId, createdAt }
//   notes/{noteId}/collab/manifest   snapshot + state vector + highest jid
//   notes/{noteId}/collab/state      v1 compacted state (read/delete only)
//   notes/{noteId}/presence/{uid}    presence + caret
//   userIndex/{sha256(email)}        directory used to add collaborators
//
// Access model
//   A note with aclSource == 'folder' takes its ACL from its folder, so revoking
//   a folder share takes effect immediately (one get() per operation) without
//   waiting for client-side propagation. Notes with aclSource == 'own' carry
//   their own ACL, which is what per-file sharing writes.
//
// Roles: owner > editor (read+write) > viewer (read only).
// Link access: link-view (read) / link-edit (write) for any signed-in user.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function uid() {
      return request.auth.uid;
    }

    function isString(v) {
      return v is string;
    }

    function isTimestamp(v) {
      return v is timestamp;
    }

    // Simple key guard: map access on a missing key raises, so check first.
    function roleOf(acl) {
      return acl.roles.keys().hasAny([uid()]) ? acl.roles[uid()] : 'none';
    }

    function rank(role) {
      return role == 'owner' ? 3 : role == 'editor' ? 2 : role == 'viewer' ? 1 : 0;
    }

    function folderDoc(id) {
      return get(/databases/$(database)/documents/folders/$(id)).data;
    }

    // Effective ACL of a note: its folder's when it inherits, its own otherwise.
    function aclOf(note) {
      return note.keys().hasAny(['aclSource']) && note.aclSource == 'folder'
        ? folderDoc(note.folderId)
        : note;
    }

    function canRead(acl) {
      return signedIn() && (
        rank(roleOf(acl)) >= 1
        || acl.access == 'link-view'
        || acl.access == 'link-edit'
      );
    }

    function canWrite(acl) {
      return signedIn() && (rank(roleOf(acl)) >= 2 || acl.access == 'link-edit');
    }

    function isAclOwner(acl) {
      return signedIn() && acl.ownerId == uid();
    }

    // ---------- plans ----------
    // Plans are granted by an admin (no payment integration yet), so a client
    // can never upgrade itself. An absent entitlement means the free plan.

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }

    function hasPaidPlan(user) {
      let path = /databases/$(database)/documents/entitlements/$(user);
      return exists(path)
        && get(path).data.plan == 'paid'
        && (!get(path).data.keys().hasAny(['expiresAt'])
          || get(path).data.expiresAt == null
          || get(path).data.expiresAt > request.time);
    }

    function sharingUnlocked() {
      return signedIn() && hasPaidPlan(uid());
    }

    // ---------- shared validation ----------

    function validAcl(d) {
      return d.memberIds is list
        && d.memberIds.size() > 0
        && d.memberIds.size() <= 50
        && d.roles is map
        && d.roles.size() <= 50
        && d.roles.keys().hasOnly(d.memberIds)
        && d.memberIds.hasOnly(d.roles.keys())
        && d.access in ['restricted', 'link-view', 'link-edit']
        && isTimestamp(d.createdAt)
        && isTimestamp(d.updatedAt);
    }

    function selfOwnedAcl(d) {
      return d.memberIds.size() == 1
        && d.memberIds[0] == uid()
        && d.roles.keys().hasOnly([uid()])
        && d.roles[uid()] == 'owner'
        && d.access == 'restricted';
    }

    // A note (or folder) whose ACL mirrors its folder's, proven by one get().
    function mirrorsFolder(folderId, d) {
      return folderId is string
        && d.memberIds == folderDoc(folderId).memberIds
        && d.roles == folderDoc(folderId).roles
        && d.access == folderDoc(folderId).access;
    }

    // ---------- folders ----------

    // Rules cannot iterate a list, so tags are validated structurally: it must
    // be a list of bounded size. Content is sanitized by the client (tags never
    // affect permissions, only filtering).
    function validTags(d) {
      return !d.keys().hasAny(['tags']) || (d.tags is list && d.tags.size() <= 30);
    }

    function validFolder(d, folderId) {
      return d.keys().hasOnly([
          'ownerId', 'name', 'parentId', 'sort', 'order', 'tags', 'memberIds', 'roles', 'access',
          'createdAt', 'updatedAt'
        ])
        && isString(d.ownerId)
        && isString(d.name)
        && d.name.size() <= 120
        // Nested folders: a folder may sit inside another, never inside itself.
        // Cycles across several levels cannot be walked here, so the client
        // validates the chain (depth cap + no cycles) before writing.
        && (!d.keys().hasAny(['parentId'])
          || d.parentId == null
          || (isString(d.parentId) && d.parentId != folderId))
        && (!d.keys().hasAny(['sort'])
          || d.sort in ['name', 'created', 'updated', 'manual'])
        && (!d.keys().hasAny(['order']) || (d.order is int && d.order >= 0))
        && validTags(d)
        && validAcl(d);
    }

    match /folders/{folderId} {
      // `resource` is null for a document that does not exist: deny cleanly
      // instead of letting the expression throw.
      allow get: if resource != null && canRead(resource.data);

      allow list: if signedIn() && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && validFolder(request.resource.data, folderId)
        && request.resource.data.ownerId == uid()
        && selfOwnedAcl(request.resource.data)
        && request.resource.data.createdAt == request.resource.data.updatedAt;

      allow update: if resource != null
        && validFolder(request.resource.data, folderId)
        && (
          (isAclOwner(resource.data)
            && aclUpdateValid(resource.data, request.resource.data)
            && (nameOnlyChange() || sharingUnlocked()))
          || (canWrite(resource.data) && nameOnlyChange())
        );

      allow delete: if resource != null && isAclOwner(resource.data);
    }

    // Owner may change sharing and members but not the identity of the folder.
    function aclUpdateValid(current, next) {
      return next.ownerId == current.ownerId
        && next.createdAt == current.createdAt
        && next.roles[uid()] == 'owner'
        && uid() in next.memberIds;
    }

    function nameOnlyChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['name', 'tags', 'sort', 'order', 'updatedAt']);
    }

    // ---------- notes ----------

    // Bodies live in notes/{id}/body/main; `markdown` stays optional on the note
    // document only so notes written before the split keep working.
    function validNote(d) {
      return d.keys().hasOnly([
          'ownerId', 'folderId', 'aclSource', 'memberIds', 'roles', 'access',
          'title', 'markdown', 'markdownBytes', 'tags', 'order', 'version', 'kind',
          'createdAt', 'updatedAt'
        ])
        // A canvas stores JSON Canvas in the same body field; the kind decides
        // how the client renders it. Absent on notes written before canvases.
        && (!d.keys().hasAny(['kind']) || d.kind in ['note', 'canvas'])
        && isString(d.ownerId)
        // Notes created before folders existed omit both fields: treat as 'own'.
        && (!d.keys().hasAny(['folderId']) || d.folderId == null || isString(d.folderId))
        && (!d.keys().hasAny(['aclSource']) || d.aclSource in ['own', 'folder'])
        && validAcl(d)
        && isString(d.title)
        && d.title.size() <= 300
        // Only legacy notes carry the body here. The cap is in bytes and the
        // client caps at 250.000 characters, which is more than 250.000 bytes
        // once the text has accents.
        && (!d.keys().hasAny(['markdown'])
          || (isString(d.markdown) && d.markdown.size() <= 600000))
        && (!d.keys().hasAny(['markdownBytes'])
          || (d.markdownBytes is int && d.markdownBytes >= 0 && d.markdownBytes <= 600000))
        && validTags(d)
        && (!d.keys().hasAny(['order']) || (d.order is int && d.order >= 0))
        && (!d.keys().hasAny(['version']) || d.version is int);
    }

    // A note body. Kept apart from the note document so the workspace list (one
    // snapshot per user) never downloads every body.
    function validBody(d) {
      return d.keys().hasOnly(['markdown', 'bytes', 'version', 'updatedAt'])
        && isString(d.markdown)
        && d.markdown.size() <= 600000
        && (!d.keys().hasAny(['bytes']) || (d.bytes is int && d.bytes >= 0))
        && (!d.keys().hasAny(['version']) || d.version is int)
        && (!d.keys().hasAny(['updatedAt']) || isTimestamp(d.updatedAt));
    }

    function contentOnlyChange() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['title', 'markdown', 'markdownBytes', 'tags', 'order', 'updatedAt', 'version']);
    }

    function ownershipUnchanged(current, next) {
      return next.ownerId == current.ownerId && next.createdAt == current.createdAt;
    }

    match /notes/{noteId} {
      allow get: if resource != null && canRead(aclOf(resource.data));

      allow list: if signedIn() && uid() in resource.data.memberIds;

      allow create: if signedIn()
        && validNote(request.resource.data)
        && request.resource.data.ownerId == uid()
        && request.resource.data.createdAt == request.resource.data.updatedAt
        && (
          // Root note, owned outright.
          (request.resource.data.folderId == null
            && request.resource.data.aclSource == 'own'
            && selfOwnedAcl(request.resource.data))
          // Note created inside a folder inherits that folder's ACL.
          || (request.resource.data.folderId != null
            && request.resource.data.aclSource == 'folder'
            && canWrite(folderDoc(request.resource.data.folderId))
            && mirrorsFolder(request.resource.data.folderId, request.resource.data))
        );

      allow update: if resource != null
        && validNote(request.resource.data)
        && ownershipUnchanged(resource.data, request.resource.data)
        && (
          // Owner: sharing, moving between folders, or content. Changing who can
          // access a note is a paid feature; content edits are not gated.
          (isAclOwner(resource.data)
            && ownerUpdateValid(resource.data, request.resource.data)
            && (contentOnlyChange() || sharingUnlocked()))
          // Editor / link-editor: content only.
          || (canWrite(aclOf(resource.data)) && contentOnlyChange())
          // Any writer of the folder may resync an inheriting note's ACL copy
          // (only for display/listing; authority always comes from the folder).
          || (resource.data.keys().hasAny(['aclSource'])
            && resource.data.aclSource == 'folder'
            && resource.data.folderId is string
            && canWrite(folderDoc(resource.data.folderId))
            && mirrorsFolder(resource.data.folderId, request.resource.data)
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['memberIds', 'roles', 'access', 'updatedAt']))
        );

      allow delete: if resource != null && isAclOwner(resource.data);
    }

    // Owner edits keep the note consistent: an inheriting note must mirror its
    // folder, an own-ACL note must keep the owner as owner.
    function ownerUpdateValid(current, next) {
      return (next.aclSource == 'own' && next.roles[uid()] == 'owner' && uid() in next.memberIds)
        || (next.aclSource == 'folder'
          && next.folderId != null
          && canWrite(folderDoc(next.folderId))
          && mirrorsFolder(next.folderId, next));
    }

    // ---------- collaboration sub-collections ----------

    function noteAcl(noteId) {
      return aclOf(get(/databases/$(database)/documents/notes/$(noteId)).data);
    }

    // The note as this commit leaves it. A batched write is evaluated against the
    // state *before* it, so `get()` cannot see the note a `createNote` batch is
    // writing in the same commit: the body would be denied with a null-data
    // error. `getAfter()` sees it, and is identical to `get()` for a body write
    // on a note that already exists.
    function noteAclAfter(noteId) {
      return aclOf(getAfter(/databases/$(database)/documents/notes/$(noteId)).data);
    }

    // The note body: one document, same ACL as the note it belongs to.
    match /notes/{noteId}/body/{docId} {
      allow read: if canRead(noteAcl(noteId));

      allow create, update: if canWrite(noteAclAfter(noteId))
        && docId == 'main'
        && validBody(request.resource.data);

      // Deleting a note removes its body; writers may also drop it explicitly.
      allow delete: if canWrite(noteAcl(noteId));
    }

    // One block of the Yjs log. The envelope is what makes blocks verifiable and
    // bounded: version, monotonic jid, content hash, size.
    match /notes/{noteId}/updates/{updateId} {
      allow read: if canRead(noteAcl(noteId));

      allow create: if canWrite(noteAcl(noteId))
        && request.resource.data.keys().hasOnly([
            'v', 'jid', 'hash', 'bytes', 'data', 'clientId', 'createdAt'
          ])
        && request.resource.data.v == 1
        && request.resource.data.jid is int
        && request.resource.data.jid > 0
        && request.resource.data.hash is string
        && request.resource.data.hash.matches('^[0-9a-f]{12}$')
        && request.resource.data.bytes is int
        && request.resource.data.bytes > 0
        && request.resource.data.bytes <= 500000
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 620000
        && request.resource.data.clientId is int
        && isTimestamp(request.resource.data.createdAt);

      // Compaction prunes exactly the blocks it folded into the snapshot.
      allow delete: if canWrite(noteAcl(noteId));

      allow update: if false;
    }

    // Manifest: metadata + snapshot, never the whole log. Joining reads this
    // document first (Dropbox's SFJ + JID cursor).
    match /notes/{noteId}/collab/manifest {
      allow read: if canRead(noteAcl(noteId));

      allow write: if canWrite(noteAcl(noteId))
        && request.resource.data.keys().hasOnly([
            'epoch', 'snapshot', 'stateVector', 'jid', 'bytes', 'clientId', 'updatedAt'
          ])
        && request.resource.data.epoch == 1
        && isString(request.resource.data.snapshot)
        && request.resource.data.snapshot.size() <= 900000
        && isString(request.resource.data.stateVector)
        && request.resource.data.stateVector.size() <= 4096
        && request.resource.data.jid is int
        && request.resource.data.jid >= 0
        && request.resource.data.bytes is int
        && request.resource.data.clientId is int
        && isTimestamp(request.resource.data.updatedAt);
    }

    // v1 compacted state: readable, and deletable by writers so it can be folded
    // into the manifest and dropped.
    match /notes/{noteId}/collab/state {
      allow read: if canRead(noteAcl(noteId));

      allow create, update: if canWrite(noteAcl(noteId))
        && request.resource.data.keys().hasOnly(['state', 'clientId', 'updatedAt'])
        && isString(request.resource.data.state)
        && request.resource.data.state.size() <= 700000
        && request.resource.data.clientId is int
        && isTimestamp(request.resource.data.updatedAt);

      allow delete: if canWrite(noteAcl(noteId));
    }

    match /notes/{noteId}/presence/{presenceId} {
      allow read: if canRead(noteAcl(noteId));

      allow write: if canWrite(noteAcl(noteId))
        && presenceId == uid()
        && request.resource.data.keys().hasOnly([
            'userId', 'clientId', 'name', 'color', 'cursor', 'selection', 'updatedAt'
          ])
        && request.resource.data.userId == uid()
        && request.resource.data.clientId is int
        && isString(request.resource.data.name)
        && request.resource.data.name.size() <= 120
        && isString(request.resource.data.color)
        && request.resource.data.color.size() <= 32
        && isString(request.resource.data.cursor)
        && request.resource.data.cursor.size() <= 4096
        && isString(request.resource.data.selection)
        && request.resource.data.selection.size() <= 8192
        && isTimestamp(request.resource.data.updatedAt);

      allow delete: if presenceId == uid();
    }

    // ---------- collaborator directory ----------
    // Document id is sha256(lowercased email); entries are readable one by one
    // but never listable, so the directory cannot be harvested.
    match /userIndex/{entryId} {
      allow get: if signedIn();

      allow create, update: if signedIn()
        && entryId.matches('[0-9a-f]{64}')
        && request.resource.data.keys().hasOnly(['uid', 'email', 'name', 'updatedAt'])
        && request.resource.data.uid == uid()
        && isString(request.resource.data.email)
        && request.resource.data.email.size() <= 320
        && isString(request.resource.data.name)
        && request.resource.data.name.size() <= 120
        && isTimestamp(request.resource.data.updatedAt);

      allow delete: if signedIn() && resource.data.uid == uid();
    }

    // ---------- display names ----------
    // uid -> { name }. Readable by any signed-in user so the share panel can show
    // who a member is; carries no email or other personal data.
    match /profiles/{profileId} {
      allow get: if signedIn();

      allow create, update: if signedIn()
        && profileId == uid()
        && request.resource.data.keys().hasOnly(['name', 'updatedAt'])
        && isString(request.resource.data.name)
        && request.resource.data.name.size() <= 120
        && isTimestamp(request.resource.data.updatedAt);

      allow delete: if profileId == uid();
    }

    // ---------- agentes conectados ----------
    // Cada sesión de la CLI (o de la app de escritorio) se registra sola al
    // loguearse con la cuenta del dueño. El id lo elige el cliente y no cambia;
    // el nombre se edita desde la app o con `firemd name`. Sólo lectura y
    // edición del nombre: nada acá concede permisos sobre notas.
    function validAgent(d) {
      return d.keys().hasOnly(['ownerUid', 'name', 'kind', 'version', 'createdAt', 'lastSeenAt'])
        && isString(d.ownerUid)
        && isString(d.name)
        && d.name.size() > 0
        && d.name.size() <= 80
        && isString(d.kind)
        && d.kind.size() <= 20
        && isString(d.version)
        && d.version.size() <= 40
        && isTimestamp(d.createdAt)
        && isTimestamp(d.lastSeenAt);
    }

    match /agents/{agentId} {
      allow get: if resource != null && resource.data.ownerUid == uid();

      allow list: if signedIn() && resource.data.ownerUid == uid();

      allow create: if signedIn()
        && validAgent(request.resource.data)
        && request.resource.data.ownerUid == uid();

      allow update: if resource != null
        && resource.data.ownerUid == uid()
        && validAgent(request.resource.data)
        && request.resource.data.ownerUid == uid()
        && request.resource.data.createdAt == resource.data.createdAt;

      allow delete: if resource != null && resource.data.ownerUid == uid();
    }

    // ---------- plans ----------
    match /admins/{adminId} {
      allow get: if signedIn();
      allow list, write: if false;
    }

    match /entitlements/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if false;

      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['plan', 'source', 'expiresAt', 'updatedAt'])
        && request.resource.data.plan in ['free', 'paid']
        && isString(request.resource.data.source)
        && request.resource.data.source.size() <= 40
        && isTimestamp(request.resource.data.updatedAt);
    }

    // ---------- user settings ----------
    match /settings/{userId} {
      allow get: if signedIn() && uid() == userId;
      allow list: if false;

      allow write: if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly(['rootSort', 'updatedAt'])
        && request.resource.data.rootSort in ['name', 'created', 'updated', 'manual']
        && isTimestamp(request.resource.data.updatedAt);
    }

    // ---------- usage ----------
    // Client-measured counters: good for transparency, never for billing.
    // Each month is its own bucket, so a rollover cannot mislabel last month's
    // totals as this month's. The legacy single document stays writable for one
    // deploy cycle so a cached bundle does not break.
    match /usage/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if false;

      allow write: if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly([
            'month', 'writes', 'reads', 'deletes', 'bytesWritten', 'bytesRead', 'storageBytes', 'updatedAt'
          ])
        && request.resource.data.month is string
        && request.resource.data.month.matches('^[0-9]{4}-[0-9]{2}$')
        && request.resource.data.writes is int && request.resource.data.writes >= 0
        && request.resource.data.reads is int && request.resource.data.reads >= 0
        && (!request.resource.data.keys().hasAny(['deletes'])
          || (request.resource.data.deletes is int && request.resource.data.deletes >= 0))
        && request.resource.data.bytesWritten is int && request.resource.data.bytesWritten >= 0
        && request.resource.data.bytesRead is int && request.resource.data.bytesRead >= 0
        && (!request.resource.data.keys().hasAny(['storageBytes'])
          || (request.resource.data.storageBytes is int && request.resource.data.storageBytes >= 0))
        && isTimestamp(request.resource.data.updatedAt);

      match /months/{month} {
        allow get: if signedIn() && (uid() == userId || isAdmin());
        allow list: if false;

        // Counters are optional so the storage write and the counter write can
        // create the bucket independently; each one is validated when present.
        allow write: if signedIn()
          && uid() == userId
          && request.resource.data.keys().hasOnly([
              'month', 'writes', 'reads', 'deletes', 'bytesWritten', 'bytesRead', 'storageBytes', 'agentOps', 'updatedAt'
            ])
          && request.resource.data.month == month
          && month.matches('^[0-9]{4}-[0-9]{2}$')
          && (!request.resource.data.keys().hasAny(['writes'])
            || (request.resource.data.writes is int && request.resource.data.writes >= 0))
          && (!request.resource.data.keys().hasAny(['reads'])
            || (request.resource.data.reads is int && request.resource.data.reads >= 0))
          && (!request.resource.data.keys().hasAny(['deletes'])
            || (request.resource.data.deletes is int && request.resource.data.deletes >= 0))
          && (!request.resource.data.keys().hasAny(['bytesWritten'])
            || (request.resource.data.bytesWritten is int && request.resource.data.bytesWritten >= 0))
          && (!request.resource.data.keys().hasAny(['bytesRead'])
            || (request.resource.data.bytesRead is int && request.resource.data.bytesRead >= 0))
          && (!request.resource.data.keys().hasAny(['storageBytes'])
            || (request.resource.data.storageBytes is int && request.resource.data.storageBytes >= 0))
          && (!request.resource.data.keys().hasAny(['agentOps'])
            || (request.resource.data.agentOps is int && request.resource.data.agentOps >= 0))
          && isTimestamp(request.resource.data.updatedAt);
      }
    }

    // ---------- credits ----------
    // El saldo y el libro los escribe solo el servidor: un cliente nunca puede
    // acreditarse dinero. El dueño sí puede editar su configuración de recarga
    // (umbral, monto y auto top-up) sin tocar el saldo, y pedir una recarga.
    match /credits/{userId} {
      allow get: if signedIn() && (uid() == userId || isAdmin());
      allow list: if false;

      function validCredits() {
        return request.resource.data.keys().hasOnly([
            'balanceUsd', 'thresholdUsd', 'topUpUsd', 'autoTopUp', 'updatedAt'
          ])
          && request.resource.data.balanceUsd is number && request.resource.data.balanceUsd >= 0
          && request.resource.data.thresholdUsd is number && request.resource.data.thresholdUsd >= 0
          && request.resource.data.topUpUsd is number
          && request.resource.data.topUpUsd >= 2
          && request.resource.data.autoTopUp is bool
          && isTimestamp(request.resource.data.updatedAt);
      }

      allow create: if isAdmin() && validCredits();
      allow update: if validCredits()
        && (isAdmin()
          || (signedIn()
            && uid() == userId
            && request.resource.data.balanceUsd == resource.data.balanceUsd));
      allow delete: if isAdmin();

      // El libro mayor es inmutable desde el cliente.
      match /ledger/{entryId} {
        allow read: if signedIn() && (uid() == userId || isAdmin());
        allow write: if false;
      }

      // Solicitudes de recarga: el dueño crea la suya en estado pendiente y
      // solo el servidor la marca pagada o cancelada.
      match /topups/{topUpId} {
        allow get: if signedIn() && (uid() == userId || isAdmin());
        allow list: if signedIn() && uid() == userId;

        allow create: if signedIn()
          && uid() == userId
          && request.resource.data.keys().hasOnly(['amountUsd', 'status', 'requestedAt'])
          && request.resource.data.amountUsd is number
          && request.resource.data.amountUsd >= 2
          && request.resource.data.status == 'pending'
          && isTimestamp(request.resource.data.requestedAt);

        allow update, delete: if isAdmin();
      }
    }

    // ---------- product analytics ----------
    // Fixed event names, own events only, never listable across users.
    match /analytics/{userId}/events/{eventId} {
      allow read: if signedIn() && uid() == userId;

      allow create: if signedIn()
        && uid() == userId
        && request.resource.data.keys().hasOnly(['name', 'props', 'at'])
        && request.resource.data.name in [
            'app_open', 'note_created', 'note_shared', 'collab_session',
            'agent_linked', 'export', 'import', 'app_error'
          ]
        && request.resource.data.props is map
        && request.resource.data.props.size() <= 5
        && isTimestamp(request.resource.data.at);

      allow update, delete: if false;
    }

    // ---------- legacy v1 schema (read-only, migration) ----------
    match /users/{userId}/notes/{noteId} {
      allow read, delete: if signedIn() && uid() == userId;
      allow create, update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
